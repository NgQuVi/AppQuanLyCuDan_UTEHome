<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".feature.profile.EditProfileActivity">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/home_text_primary" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_profile_title"
            android:textColor="@color/home_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">
                
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_card_white"
                    android:backgroundTint="#FFFFFF"
                    android:clipToPadding="true"
                    android:padding="2dp">
                    
                    <ImageView
                        android:id="@+id/ivEditAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_nav_person"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_service_icon"
                        android:clipToOutline="true"/>
                </FrameLayout>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/edit_profile_avatar_label"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/edit_profile_avatar_hint"
                    android:textColor="@color/home_primary_orange"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_name_label"
                android:textColor="@color/home_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/home_text_primary"
                android:text="Nguyễn Văn An"
                android:layout_marginBottom="16dp"
                android:singleLine="true"/>

            <!-- Phone (Disabled) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_phone_label"
                android:textColor="@color/home_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_input_disabled"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="090 123 4567"
                    android:textSize="14sp"
                    android:textColor="#7A869A" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/edit_profile_phone_hint"
                android:textColor="#7A869A"
                android:textSize="10sp"
                android:layout_marginBottom="16dp"/>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_email_label"
                android:textColor="@color/home_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/home_text_primary"
                android:inputType="textEmailAddress"
                android:text="an.nguyen@email.com"
                android:layout_marginBottom="16dp"
                android:singleLine="true"/>

            <!-- DOB & Gender row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <!-- DOB -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_profile_dob_label"
                        android:textColor="@color/home_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:id="@+id/tvDobPicker"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_profile_input"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="15/05/1990"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_primary"
                        app:drawableEndCompat="@drawable/ic_calendar"
                        app:drawableTint="#7A869A" />
                </LinearLayout>

                <!-- Gender -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_profile_gender_label"
                        android:textColor="@color/home_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                    <!-- Custom Spinner placeholder -->
                    <TextView
                        android:id="@+id/tvGenderSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_profile_input"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Nam"
                        android:textSize="14sp"
                        android:textColor="@color/home_text_primary"
                        app:drawableEndCompat="@drawable/ic_expand_more"
                        app:drawableTint="#7A869A" />
                </LinearLayout>
            </LinearLayout>

            <!-- ID Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_id_type_label"
                android:textColor="@color/home_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:id="@+id/tvIdTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="CCCD / CMND"
                android:textSize="14sp"
                android:textColor="@color/home_text_primary"
                app:drawableEndCompat="@drawable/ic_expand_more"
                app:drawableTint="#7A869A" 
                android:layout_marginBottom="16dp"/>

            <!-- ID Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_id_num_label"
                android:textColor="@color/home_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/etIdNum"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_input"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/home_text_primary"
                android:inputType="number"
                android:text="012345678910"
                android:layout_marginBottom="24dp"
                android:singleLine="true"/>

            <!-- Security Note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_input_disabled"
                android:padding="16dp"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_orange"
                    android:layout_marginTop="2dp"/>
                    
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/edit_profile_security_note"
                    android:textColor="#7A869A"
                    android:textSize="10sp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/home_primary_orange"
                android:text="@string/edit_profile_btn_save"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
