<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".feature.payment.PaymentHistoryActivity">

    <!-- Header / Toolbar -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back_black"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payment_history_title"
        android:textColor="@color/home_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <!-- ScrollView content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Apartment Info Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardApartmentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_apartment_info_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvApartmentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_apartment_name"
                    android:textColor="@color/payment_apartment_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivLocationPin"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/home_text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvApartmentName" />

                <TextView
                    android:id="@+id/tvApartmentAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/payment_apartment_address"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/ivLocationPin"
                    app:layout_constraintStart_toEndOf="@id/ivLocationPin"
                    app:layout_constraintTop_toTopOf="@id/ivLocationPin" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="@string/payment_search_hint"
                    android:textColorHint="@color/home_text_secondary"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- ========== THÁNG 10/2023 ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/payment_month_oct"
                android:textColor="@color/payment_section_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Payment Card - October -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardOct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_payment_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <!-- Title row -->
                <TextView
                    android:id="@+id/tvOctTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_oct_title"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvOctStatus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvOctStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_success"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/payment_status_success"
                    android:textColor="@color/payment_success_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- DateTime -->
                <ImageView
                    android:id="@+id/ivOctClock"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_clock"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOctTitle" />

                <TextView
                    android:id="@+id/tvOctDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/payment_bill_oct_date"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/ivOctClock"
                    app:layout_constraintStart_toEndOf="@id/ivOctClock"
                    app:layout_constraintTop_toTopOf="@id/ivOctClock" />

                <!-- Divider -->
                <View
                    android:id="@+id/dividerOct1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/home_border_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivOctClock" />

                <!-- Mã giao dịch -->
                <TextView
                    android:id="@+id/tvOctCodeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/payment_label_code"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerOct1" />

                <TextView
                    android:id="@+id/tvOctCodeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_oct_code"
                    android:textColor="@color/home_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvOctCodeLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Phương thức -->
                <TextView
                    android:id="@+id/tvOctMethodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/payment_label_method"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOctCodeLabel" />

                <TextView
                    android:id="@+id/tvOctMethodValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_oct_method"
                    android:textColor="@color/home_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvOctMethodLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Divider 2 -->
                <View
                    android:id="@+id/dividerOct2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/home_border_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOctMethodLabel" />

                <!-- Tổng tiền -->
                <TextView
                    android:id="@+id/tvOctTotalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/payment_label_total"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerOct2" />

                <TextView
                    android:id="@+id/tvOctAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_oct_amount"
                    android:textColor="@color/payment_amount_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvOctTotalLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ========== THÁNG 09/2023 ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/payment_month_sep"
                android:textColor="@color/payment_section_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Payment Card - September -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardSep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_payment_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <!-- Title row -->
                <TextView
                    android:id="@+id/tvSepTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_sep_title"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvSepStatus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSepStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_success"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/payment_status_success"
                    android:textColor="@color/payment_success_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- DateTime -->
                <ImageView
                    android:id="@+id/ivSepClock"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_clock"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSepTitle" />

                <TextView
                    android:id="@+id/tvSepDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/payment_bill_sep_date"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/ivSepClock"
                    app:layout_constraintStart_toEndOf="@id/ivSepClock"
                    app:layout_constraintTop_toTopOf="@id/ivSepClock" />

                <!-- Divider -->
                <View
                    android:id="@+id/dividerSep1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/home_border_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivSepClock" />

                <!-- Mã giao dịch -->
                <TextView
                    android:id="@+id/tvSepCodeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/payment_label_code"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerSep1" />

                <TextView
                    android:id="@+id/tvSepCodeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_sep_code"
                    android:textColor="@color/home_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvSepCodeLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Phương thức -->
                <TextView
                    android:id="@+id/tvSepMethodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/payment_label_method"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSepCodeLabel" />

                <TextView
                    android:id="@+id/tvSepMethodValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_sep_method"
                    android:textColor="@color/home_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvSepMethodLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Divider 2 -->
                <View
                    android:id="@+id/dividerSep2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/home_border_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSepMethodLabel" />

                <!-- Tổng tiền -->
                <TextView
                    android:id="@+id/tvSepTotalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/payment_label_total"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerSep2" />

                <TextView
                    android:id="@+id/tvSepAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_bill_sep_amount"
                    android:textColor="@color/payment_amount_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvSepTotalLabel"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
