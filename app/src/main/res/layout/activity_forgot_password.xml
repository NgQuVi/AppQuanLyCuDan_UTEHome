<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true"
    tools:context=".feature.auth.forgotpassword.ForgotPasswordActivity">

    <!-- Wrapper LinearLayout to preserve horizontal padding from EdgeToEdge system bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Title: "Quên mật khẩu" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/forgot_title"
            android:textColor="#17213A"
            android:textSize="32sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/forgot_subtitle"
            android:textColor="#7E8CA4"
            android:textSize="14sp" />

        <!-- "SỐ ĐIỆN THOẠI" orange uppercase label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/forgot_phone_label"
            android:textAllCaps="true"
            android:textColor="#FF7E4E"
            android:textSize="11sp" />

        <!-- Phone input field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_forgot_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_phone_outline"
                app:tint="#93A0B2" />

            <EditText
                android:id="@+id/edtForgotPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/forgot_phone_hint"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="#17213A"
                android:textColorHint="#93A0B2"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Helper text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/forgot_otp_note"
            android:textColor="#7E8CA4"
            android:textSize="12sp" />

        <!-- "Gửi mã xác thực" button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#FF7E4E"
            android:fontFamily="sans-serif-medium"
            android:text="@string/forgot_send_button"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="27dp"
            app:elevation="0dp" />

        <!-- "Quay lại đăng nhập" link -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/forgot_back_to_login"
            android:textColor="#50626D"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
