<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true"
    tools:context=".feature.auth.reset.ResetPasswordActivity">

    <!-- Wrapper LinearLayout to preserve horizontal padding from EdgeToEdge system bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/reset_title"
            android:textColor="#17213A"
            android:textSize="32sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/reset_subtitle"
            android:textColor="#7E8CA4"
            android:textSize="14sp" />

        <!-- "MẬT KHẨU MỚI" label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"
            android:text="@string/reset_password_label"
            android:textAllCaps="true"
            android:textColor="#17213A"
            android:textSize="11sp" />

        <!-- Password input field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_forgot_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_outline"
                app:tint="#93A0B2" />

            <EditText
                android:id="@+id/edtNewPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/reset_password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="#17213A"
                android:textColorHint="#93A0B2"
                android:textSize="14sp" />

            <!-- Eye toggle button -->
            <ImageView
                android:id="@+id/ivToggleNewPassword"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/login_toggle_password"
                android:src="@drawable/ic_eye_off_outline"
                app:tint="#93A0B2" />
        </LinearLayout>

        <!-- "XÁC NHẬN MẬT KHẨU" label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"
            android:text="@string/reset_confirm_password_label"
            android:textAllCaps="true"
            android:textColor="#17213A"
            android:textSize="11sp" />

        <!-- Confirm Password input field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_forgot_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_outline"
                app:tint="#93A0B2" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/reset_confirm_password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="#17213A"
                android:textColorHint="#93A0B2"
                android:textSize="14sp" />

            <!-- Eye toggle button -->
            <ImageView
                android:id="@+id/ivToggleConfirmPassword"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/login_toggle_password"
                android:src="@drawable/ic_eye_off_outline"
                app:tint="#93A0B2" />
        </LinearLayout>

        <!-- Information label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info_orange" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/reset_password_info"
                android:textColor="#7E8CA4"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Divider line matching design space, optional, we use margin -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#E2E5E9" />

        <!-- "Xác nhận" button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetConfirm"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#FF7E4E"
            android:fontFamily="sans-serif-medium"
            android:text="@string/reset_button"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="27dp"
            app:elevation="0dp" />

    </LinearLayout>
</ScrollView>
