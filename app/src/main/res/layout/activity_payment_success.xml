<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".feature.invoice.PaymentSuccessActivity">

    <!-- Top Orange Background -->
    <View
        android:id="@+id/topBg"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#FFF9F6"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Success Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_invoice_card"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivSuccess"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_success_check_large"
            android:background="@drawable/bg_tag_event"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/payment_success_title"
            android:textColor="@color/home_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSuccess" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/payment_success_desc"
            android:textColor="@color/home_text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Transaction Details Block -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detailsBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FAFAFA"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvDesc">
            
            <!-- Code -->
            <TextView
                android:id="@+id/lblCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_success_tx_code"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/valCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_success_tx_code_val"
                android:textColor="@color/home_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
                
            <View
                android:id="@+id/div1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/home_border_color"
                app:layout_constraintTop_toBottomOf="@id/lblCode" />

            <!-- Time -->
             <TextView
                android:id="@+id/lblTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/payment_success_time"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/div1" />

            <TextView
                android:id="@+id/valTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_success_time_val"
                android:textColor="@color/home_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lblTime" />
                
            <!-- Method -->
             <TextView
                android:id="@+id/lblMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/payment_success_method"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblTime" />

            <TextView
                android:id="@+id/valMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_success_method_val"
                android:textColor="@color/home_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawablePadding="6dp"
                app:drawableStartCompat="@drawable/ic_momo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lblMethod"
                app:layout_constraintBottom_toBottomOf="@id/lblMethod"/>

            <View
                android:id="@+id/div2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/home_border_color"
                app:layout_constraintTop_toBottomOf="@id/lblMethod" />
                
            <!-- Total -->
            <TextView
                android:id="@+id/lblTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/payment_success_total"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/div2" />

            <TextView
                android:id="@+id/valTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.380.000đ"
                android:textColor="@color/login_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/lblTotal"
                app:layout_constraintBottom_toBottomOf="@id/lblTotal"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/payment_success_btn_home"
            android:backgroundTint="@color/login_primary"
            app:cornerRadius="8dp"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toBottomOf="@id/detailsBlock" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
