<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card_white"
    android:backgroundTint="#FAFAFA"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_card_white"
        android:backgroundTint="#FFF3E0"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/home_primary_orange"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đợt 1: Thang máy 1, 2 &amp; 3"
            android:textColor="@color/home_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Thời gian: 08:00 - 12:00, ngày 16/10/2023"
            android:textColor="@color/home_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
