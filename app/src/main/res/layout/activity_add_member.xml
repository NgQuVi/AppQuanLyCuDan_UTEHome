<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".feature.member.AddMemberActivity">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:background="@color/home_background"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_arrow_back_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm thành viên"
            android:textColor="@color/home_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Avatar Upload Section -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivMemberAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_placeholder_avatar"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_member_avatar_large"
                    android:clipToOutline="true"
                    android:contentDescription="Member Avatar" />

                <ImageView
                    android:id="@+id/ivCameraIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_camera"
                    android:background="@drawable/bg_camera_icon"
                    android:padding="8dp"
                    android:contentDescription="Upload Photo"
                    android:scaleType="centerInside" />

            </FrameLayout>

            <!-- Text "Nhấn để tải ảnh lên" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhấn để tải ảnh lên"
                android:textColor="@color/home_primary_orange"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"/>

            <!-- Full Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và tên *"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập họ và tên"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="16sp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/home_text_hint" />

            <!-- Gender Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giới tính"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etGender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Chọn giới tính"
                android:inputType="none"
                android:paddingHorizontal="12dp"
                android:textSize="16sp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/home_text_hint"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:cursorVisible="false" />

            <!-- ID Number Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số định danh"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etIdNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập số định danh"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="16sp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/home_text_hint" />

            <!-- Relationship Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quan hệ với chủ hộ *"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etRelation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập quan hệ (vợ/chồng, con, ...)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="16sp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/home_text_hint" />

            <!-- Date of Birth Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày sinh"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="mm/dd/yyyy"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:paddingEnd="40dp"
                android:textSize="16sp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/home_text_hint" />

            <!-- Phone Number Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số điện thoại"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="+84"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="000 000 000"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:background="@null"
                    android:textColorHint="@color/home_text_hint" />

            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSaveMember"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Lưu thông tin"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_orange"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
