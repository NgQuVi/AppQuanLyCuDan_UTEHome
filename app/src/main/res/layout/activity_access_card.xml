<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".feature.accesscard.AccessCardActivity">

    <!-- Top bar with back button and title -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@drawable/ic_nav_person"
        android:contentDescription="@string/access_card_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/access_card_title"
        android:textColor="@color/home_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAccessCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Resident access card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardResidentAccess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Orange top bar -->
                <View
                    android:id="@+id/viewTopBar"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:background="@color/home_primary_orange"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Vehicle pass label -->
                <TextView
                    android:id="@+id/tvVehiclePassLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_tag_event"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/access_card_vehicle_pass"
                    android:textColor="@color/home_tag_event_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/viewTopBar" />

                <!-- Vehicle icon -->
                <ImageView
                    android:id="@+id/ivVehicleIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_service_icon"
                    android:padding="6dp"
                    android:src="@drawable/ic_vehicle"
                    android:contentDescription="@string/home_service_vehicle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/viewTopBar" />

                <!-- Plate number -->
                <TextView
                    android:id="@+id/tvPlateNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:text="30A - 888.88"
                    android:textColor="@color/home_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVehiclePassLabel" />

                <!-- Vehicle type & model -->
                <TextView
                    android:id="@+id/tvVehicleInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Ô tô • Mercedes-Benz GLC 300"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPlateNumber" />

                <!-- QR code image -->
                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_white"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_nav_person"
                    android:contentDescription="@string/access_card_resident"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVehicleInfo" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tvCardDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/access_card_description"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivQrCode" />

                <!-- Divider -->
                <View
                    android:id="@+id/viewDivider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/home_text_secondary"
                    android:alpha="0.2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCardDescription" />

                <!-- Info rows: Resident, Apartment, Color, Expired date -->

                <!-- Resident -->
                <TextView
                    android:id="@+id/tvResidentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/access_card_resident"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/viewDivider" />

                <!-- Apartment -->

                <TextView
                    android:id="@+id/tvResidentName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Văn A"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/tvResidentLabel"
                    app:layout_constraintTop_toTopOf="@id/tvResidentLabel" />

                <TextView
                    android:id="@+id/tvApartmentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/access_card_apartment"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvResidentLabel" />

                <TextView
                    android:id="@+id/tvApartmentValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="P.1205, Tòa S1"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvApartmentLabel"
                    app:layout_constraintTop_toTopOf="@id/tvApartmentLabel" />

                <!-- Color -->
                <TextView
                    android:id="@+id/tvColorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/access_card_color"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvApartmentLabel" />

                <!-- Expired -->
                <TextView
                    android:id="@+id/tvColorValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Trắng"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/tvColorLabel"
                    app:layout_constraintTop_toTopOf="@id/tvColorLabel" />

                <TextView
                    android:id="@+id/tvExpiredLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/access_card_expired_date"
                    android:textColor="@color/home_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvColorLabel" />

                <!-- Bottom spacer -->
                <TextView
                    android:id="@+id/tvExpiredValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="31/12/2024"
                    android:textColor="@color/home_primary_orange"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/tvExpiredLabel"
                    app:layout_constraintTop_toTopOf="@id/tvExpiredLabel" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvExpiredValue" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
