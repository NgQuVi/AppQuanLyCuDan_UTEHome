<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer faint glow -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#1AFF7E4E" /> <!-- 10% opacity orange -->
        </shape>
    </item>
    <!-- Inner faint glow -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="#26FF7E4E" /> <!-- 15% opacity orange -->
        </shape>
    </item>
    <!-- Core solid orange circle -->
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="#FF7E4E" /> <!-- Solid orange -->
        </shape>
    </item>
</layer-list>
