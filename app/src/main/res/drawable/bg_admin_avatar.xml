<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dashboard_avatar_bg" />
        </shape>
    </item>
    <item android:gravity="center_horizontal|bottom" android:bottom="4dp">
        <shape android:shape="oval">
            <size android:width="14dp" android:height="10dp" />
            <solid android:color="@color/dashboard_avatar_dark" />
        </shape>
    </item>
    <item android:gravity="center_horizontal|top" android:top="5dp">
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="@color/dashboard_avatar_dark" />
        </shape>
    </item>
</layer-list>
