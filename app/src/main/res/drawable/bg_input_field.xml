<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_white" />
            <stroke android:width="1.5dp" android:color="@color/brand_orange" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/field_fill" />
            <stroke android:width="1dp" android:color="@color/field_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
